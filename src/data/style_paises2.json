{
  "version": 8,
  "name": "Países del mundo · gris claro · etiquetas por zoom",
  "center": [
    0,
    20
  ],
  "zoom": 1.4,
  "sources": {
    "countries": {
      "type": "geojson",
      "data": "./paises.geojson"
    },
    "country-labels": {
      "type": "geojson",
      "data": "./etiquetas_paises.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#CFE8F3"
      }
    },
    {
      "id": "country-fill",
      "type": "fill",
      "source": "countries",
      "paint": {
        "fill-color": "#d8dde1",
        "fill-opacity": 1
      }
    },
    {
      "id": "country-borders",
      "type": "line",
      "source": "countries",
      "paint": {
        "line-color": "#818991",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.35,
          4,
          0.65,
          8,
          1.1,
          12,
          1.5
        ],
        "line-opacity": 0.9
      }
    },
    {
      "id": "country-labels",
      "type": "symbol",
      "source": "country-labels",
      "layout": {
        "text-field": [
          "step",
          [
            "zoom"
          ],
          [
            "get",
            "ISO2"
          ],
          3,
          [
            "get",
            "ISO3"
          ],
          5,
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Open Sans Regular",
          "Arial Unicode MS Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          10,
          3,
          11,
          5,
          12,
          9,
          14
        ],
        "text-max-width": 10,
        "text-allow-overlap": false,
        "text-ignore-placement": false,
        "text-optional": false,
        "text-anchor": "center",
        "text-padding": 2
      },
      "paint": {
        "text-color": "#40474d",
        "text-halo-color": "#eef0f2",
        "text-halo-width": 1.25,
        "text-halo-blur": 0.3
      }
    }
  ]
}
